#!/usr/bin/env ruby
# script/update_contributions — regenerate the data behind the About window's Contributions page.
#
# The page lists every commit to this repository, by everyone. Its data is one
# JSON file per year in Applications/TextMate/resources/Contributions, committed
# to the repository, so a build needs neither the network nor a GitHub token.
# Run this after merging, and before a release, then commit the result. The
# commit that adds the files is itself not in them, which is the nature of it.
#
# git supplies the commits. GitHub supplies, for each commit, the account it
# resolves the author to, login and avatar, which is the one thing git does not
# know and the only reason this script talks to the network. Commits already in
# the files keep what they have, so a run asks GitHub about the commits since
# the last run and no others. A run without gh, or offline, writes those with
# their name alone and says so.

require "json"
require "open3"
require "set"

REPOSITORY  = "textmate3/textmate"
ROOT        = File.expand_path("..", __dir__)
DESTINATION = File.join(ROOT, "Applications/TextMate/resources/Contributions")

# The commits GitHub knows, newest first, one hundred a page, each with the
# account it resolved the author to or nil. Stops at the page where the last
# wanted commit was found, so a routine run reads one page.
def github_accounts(wanted)
  found  = {}
  wanted = wanted.to_set
  return found if wanted.empty?

  unless system("gh", "auth", "status", out: File::NULL, err: File::NULL)
    warn "update_contributions: gh is not authenticated, so #{wanted.size} commits are written without their GitHub accounts"
    return found
  end

  page = 1
  until wanted.empty?
    output, status = Open3.capture2("gh", "api", "repos/#{REPOSITORY}/commits?per_page=100&page=#{page}")
    unless status.success?
      warn "update_contributions: gh api failed on page #{page}, so #{wanted.size} commits are written without their GitHub accounts"
      break
    end

    commits = JSON.parse(output)
    break if commits.empty?

    commits.each do |commit|
      next unless wanted.delete?(commit.fetch("sha"))

      # A commit with no author email comes back with an empty object here rather than nil.
      account = commit["author"]
      found[commit.fetch("sha")] = account && account["login"] ? { "login" => account["login"], "avatar_url" => account["avatar_url"] } : nil
    end
    page += 1
  end

  warn "update_contributions: #{wanted.size} commits are not on GitHub yet and are written with their name alone" unless wanted.empty?
  found
end

existing = {}
Dir.glob(File.join(DESTINATION, "*.json")).each do |path|
  JSON.parse(File.read(path)).fetch("commits").each { existing[it.fetch("hash")] = it }
end

# Hash, author date, author name, summary and body, each field ended by a NUL
# and each commit by a record separator, neither of which a message can hold.
format = "%H%x00%aI%x00%an%x00%s%x00%b%x1e"
log, status = Open3.capture2("git", "-C", ROOT, "log", "--format=#{format}")
abort "update_contributions: git log failed" unless status.success?

commits = log.split("\x1e").filter_map do |record|
  hash, date, name, summary, body = record.sub(/\A\n/, "").split("\x00", 5)
  next if hash.nil? || hash.empty?

  { hash: hash, date: date, name: name, summary: summary, body: body.to_s.strip }
end

accounts = github_accounts(commits.map { it[:hash] }.reject { existing.key?(it) })

records = commits.map do |commit|
  if (record = existing[commit[:hash]])
    record
  else
    account = accounts[commit[:hash]]
    {
      "hash"    => commit[:hash],
      "date"    => commit[:date],
      "author"  => {
        "name"       => commit[:name],
        "login"      => account && account["login"],
        "avatar_url" => account && account["avatar_url"],
      },
      "summary" => commit[:summary],
      "body"    => commit[:body],
    }
  end
end

# One file per year of the author date, newest commit first within it. A year
# that is over never changes again, so its file does not either.
Dir.mkdir(DESTINATION) unless File.directory?(DESTINATION)
by_year = records.group_by { it.fetch("date")[0, 4].to_i }
by_year.sort.each do |year, year_records|
  path = File.join(DESTINATION, "#{year}.json")
  File.write(path, JSON.pretty_generate({ "year" => year, "commits" => year_records }) + "\n")
  puts "  #{year}  #{year_records.size} commits"
end

without_account = records.count { it.fetch("author")["login"].nil? }
puts "#{records.size} commits in #{by_year.size} files, #{without_account} without a GitHub account"
