#!/usr/bin/env ruby
# script/benchmark_bundle_index — measure what the bundle index cache saves at launch
#
# The bundle index cache is what lets a warm launch skip re-reading every bundle
# item. This script launches the application hidden and in the background against
# a scratch cache, so the real one is never touched, alternating between no cache
# and a warm cache. The application reports the cache load, the index build and
# the whole launch on stderr, and the report shows medians of each.
#
# It needs no TextMate running, this build or the official one, since two
# instances share Application Support and the mate server port. It never
# activates a window.
#
# Usage:
#   script/benchmark_bundle_index                    # build, then five launches of each kind
#   script/benchmark_bundle_index --launches 10      # more launches
#   script/benchmark_bundle_index --out results.md   # also write the report to a file

require 'fileutils'
require 'optparse'
require 'tmpdir'

Dir.chdir(File.expand_path('..', __dir__))

options = { launches: 5, out: nil }
OptionParser.new do |parser|
  parser.banner = 'usage: script/benchmark_bundle_index [options]'
  parser.on('--launches N', Integer, 'launch pairs, one without and one with a cache, default 5') { options[:launches] = it }
  parser.on('--out PATH', 'write the report here as well as to the terminal') { options[:out] = it }
end.parse!

running = `pgrep -x TextMate`.split
abort("TextMate is running (process #{running.join(', ')}). Quit every TextMate, this build and the official one, and run again.") if running.any?

system('ninja', 'TextMate') or abort('build failed')

build_directory = File.read('build.ninja')[/^builddir = (.+)$/, 1] or abort('no builddir in build.ninja, run ./configure')
application = File.join(build_directory, 'release/Applications/TextMate/TextMate.app')

# ===========
# = Helpers =
# ===========

def median(values)
  sorted = values.sort
  middle = sorted.size / 2
  sorted.size.odd? ? sorted[middle] : (sorted[middle - 1] + sorted[middle]) / 2.0
end

def milliseconds(value) = format('%.1f', value)

# Number columns are right aligned so the digits line up, text columns left.
# A column is text when its header says so.
def markdown_table(headers, rows, text_columns: [headers.first])
  widths = headers.each_index.map { |column| ([headers[column]] + rows.map { it[column].to_s }).map(&:size).max }
  numeric = headers.map { !text_columns.include?(it) }
  line = ->(cells) { "| #{cells.each_with_index.map { |cell, column| numeric[column] ? cell.to_s.rjust(widths[column]) : cell.to_s.ljust(widths[column]) }.join(' | ')} |" }
  separator = "|#{headers.each_index.map { |column| numeric[column] ? "#{'-' * (widths[column] + 1)}:" : "-#{'-' * (widths[column] + 1)}" }.join('|')}|"
  [line.call(headers), separator, *rows.map { line.call(it) }].join("\n")
end

def wait_for(seconds)
  deadline = Time.now + seconds
  until Time.now > deadline
    return true if yield

    sleep 0.2
  end
  false
end

def launch_once(application:, cache_path:, log_path:, warm:)
  File.delete(cache_path) if !warm && File.exist?(cache_path)
  File.delete(log_path) if File.exist?(log_path)

  system('open', '-g', '-j', '-n',
         '--env', 'TEXTMATE_BUNDLES_INDEX_TIMING=1',
         '--env', "TEXTMATE_BUNDLES_INDEX_PATH=#{cache_path}",
         '--stderr', log_path,
         '-a', application,
         '--args', '-disableSessionRestore', 'YES') or return nil

  finished = wait_for(60) { File.exist?(log_path) && File.read(log_path).include?("launch\t") }
  lines = finished ? File.read(log_path).lines.map { it.chomp.split("\t") } : []
  pid = lines.find { it[0] == 'launch' }&.at(1)&.to_i

  # A launch without a cache writes one a few seconds later, once the file
  # system watch delivers its first event ids. The next warm launch needs it.
  wait_for(20) { File.exist?(cache_path) } unless warm

  # SIGKILL rather than a quit: a quit saves the session and project state,
  # which would overwrite the real ones with this throwaway launch's. Nothing
  # of value is lost, the cache above is already on disk.
  system('kill', '-KILL', pid.to_s, err: File::NULL) if pid
  wait_for(10) { !system('kill', '-0', pid.to_s, err: File::NULL) } if pid

  return nil unless finished

  {
    load: lines.find { it[0] == 'bundles_index' && it[1] == 'load' }&.at(2).to_f,
    index: lines.find { it[0] == 'bundles_index' && it[1] == 'index' }&.at(2).to_f,
    launch: lines.find { it[0] == 'launch' }&.at(2).to_f
  }
end

# ============
# = Launches =
# ============

puts "Launching the application #{options[:launches]} times without a cache and #{options[:launches]} times with one…"
samples = { cold: [], warm: [] }
load_averages = []
Dir.mktmpdir('bundle_index_benchmark') do |scratch|
  # The launched application writes its window session half a second after
  # any window event, into the same file the real one reads at its next
  # launch. Keep a copy and put it back afterwards, whatever happens.
  session_path = File.expand_path('~/Library/Application Support/TextMate/Session/Info.plist')
  session_backup = File.join(scratch, 'Session.plist')
  FileUtils.cp(session_path, session_backup) if File.exist?(session_path)

  begin
    cache_path = File.join(scratch, 'BundlesIndex.plist')
    options[:launches].times do |i|
      load_averages << `sysctl -n vm.loadavg`[/\{ ([\d.]+)/, 1].to_f
      %i[cold warm].each do |mode|
        sample = launch_once(application:, cache_path:, log_path: File.join(scratch, "launch_#{i}_#{mode}.log"), warm: mode == :warm)
        if sample
          samples[mode] << sample
          puts "  #{mode}: launch #{milliseconds(sample[:launch])} ms, cache load #{milliseconds(sample[:load])} ms, index #{milliseconds(sample[:index])} ms"
        else
          warn "  #{mode}: launch did not report, see #{scratch}"
        end
      end
    end
  ensure
    FileUtils.cp(session_backup, session_path) if File.exist?(session_backup)
  end
end

# ==========
# = Report =
# ==========

machine = `sysctl -n machdep.cpu.brand_string`.strip
macos = `sw_vers -productVersion`.strip

report = []
report << '# Bundle index cache benchmark'
report << ''
report << "#{Time.now.strftime('%Y-%m-%d %H:%M')}, #{machine}, macOS #{macos}."
report << "Load average during the launches: #{load_averages.min} to #{load_averages.max}. Anything above the core count means the machine was busy and the numbers are noisy."
report << ''
report << 'The application launched hidden and in the background, alternating no cache and a warm cache. Launch is from process start to the end of application launch, dyld and framework loading included. Cache load and index are the two steps inside it that the cache affects.'
report << ''
rows = %i[cold warm].map do |mode|
  values = samples[mode]
  next [mode == :cold ? 'No cache' : 'Warm cache', 0, '', '', '', ''] if values.empty?

  [mode == :cold ? 'No cache' : 'Warm cache', values.size, milliseconds(median(values.map { it[:launch] })), milliseconds(values.map { it[:launch] }.min), milliseconds(median(values.map { it[:load] })), milliseconds(median(values.map { it[:index] }))]
end
report << markdown_table(['Launch', 'Runs', 'Launch median ms', 'Launch min ms', 'Cache load median ms', 'Index median ms'], rows)

text = "#{report.join("\n")}\n"
puts
puts text
File.write(options[:out], text) if options[:out]
