#!/usr/bin/env ruby
# script/generate_grapheme_tables — write the Unicode tables that grapheme boundaries are found with.
#
# Usage:
#   script/generate_grapheme_tables          # Unicode 17.0.0
#   script/generate_grapheme_tables 18.0.0   # once Unicode publishes the next version
#
# A grapheme boundary depends on three properties of each code point: its
# grapheme cluster break value, whether it is extended pictographic, and its
# Indic conjunct break value. This downloads the three files of the Unicode
# Character Database that define them and writes one byte per code point,
# packed into a two stage table, to Frameworks/text/src/grapheme_table.cc.
# It also saves Unicode's own boundary tests as a fixture beside the text
# framework's tests, so the tests always check the version the table carries.
#
# Unicode publishes a new version each September. Run this with the new
# version, run script/test text, and commit both files together.

require "net/http"

class GraphemeTables
  ROOT    = File.expand_path("..", __dir__)
  TABLE   = File.join(ROOT, "Frameworks/text/src/grapheme_table.cc")
  FIXTURE = File.join(ROOT, "Frameworks/text/tests/fixtures/GraphemeBreakTest.txt")

  # The order is the numbering grapheme_break.h gives the values, in the low four bits.
  BREAK_VALUES = %w[Other CR LF Control Extend ZWJ Regional_Indicator Prepend SpacingMark L V T LV LVT].freeze

  EXTENDED_PICTOGRAPHIC = 0x10
  CONJUNCT_VALUES       = { "Consonant" => 0x20, "Extend" => 0x40, "Linker" => 0x60 }.freeze

  BLOCK_SIZE  = 256
  CODE_POINTS = 0x110000

  attr_reader :version

  def initialize(version:)
    @version = version
  end

  def write
    properties = Array.new(CODE_POINTS, 0)
    each_range("auxiliary/GraphemeBreakProperty.txt") do |first, last, value|
      (first..last).each { properties[it] |= BREAK_VALUES.index(value) || abort("unknown break value #{value}") }
    end
    each_range("emoji/emoji-data.txt") do |first, last, value|
      next unless value == "Extended_Pictographic"

      (first..last).each { properties[it] |= EXTENDED_PICTOGRAPHIC }
    end
    each_range("DerivedCoreProperties.txt") do |first, last, value, conjunct|
      next unless value == "InCB"

      (first..last).each { properties[it] |= CONJUNCT_VALUES.fetch(conjunct) }
    end

    blocks = properties.each_slice(BLOCK_SIZE).to_a
    unique = blocks.uniq
    abort "#{unique.size} distinct blocks do not fit a one byte index" if unique.size > 256
    index = blocks.map { unique.index(it) }

    File.write(TABLE, source(index:, blocks: unique))
    File.write(FIXTURE, download("auxiliary/GraphemeBreakTest.txt"))
    puts "Unicode #{version}: #{unique.size} distinct blocks, #{index.size + (unique.size * BLOCK_SIZE)} bytes"
  end

  private

  # Each line of a Unicode data file as its first and last code point and its fields after the first.
  def each_range(path)
    download(path).each_line do |line|
      data = line.sub(/#.*/, "").strip
      next if data.empty?

      fields = data.split(";").map(&:strip)
      first, last = fields.first.split("..").map { it.to_i(16) }
      yield first, last || first, *fields.drop(1)
    end
  end

  def download(path)
    @downloads ||= {}
    @downloads[path] ||= begin
      url = URI("https://www.unicode.org/Public/#{version}/ucd/#{path}")
      response = Net::HTTP.get_response(url)
      abort "#{url}: #{response.code} #{response.message}" unless response.is_a?(Net::HTTPSuccess)
      response.body
    end
  end

  def source(index:, blocks:)
    <<~SOURCE
      // Generated by script/generate_grapheme_tables from Unicode #{version}. Do not edit by hand.
      // One byte per code point, see grapheme_break.h: the grapheme cluster break value in the low
      // four bits, 0x10 for extended pictographic, and the Indic conjunct break value in 0x60.
      // A code point's byte is kBlocks[kBlockIndex[code point >> 8] * 256 + (code point & 0xFF)].

      #include "grapheme_break.h"

      namespace grapheme
      {
      \tchar const* const kUnicodeVersion = "#{version}";

      \tuint8_t const kBlockIndex[#{index.size}] = {
      #{rows(index)}
      \t};

      \tuint8_t const kBlocks[#{blocks.size} * #{BLOCK_SIZE}] = {
      #{blocks.map { rows(it) }.join("\n")}
      \t};

      } /* grapheme */
    SOURCE
  end

  def rows(values)
    values.each_slice(32).map { |row| "\t\t#{row.map { format("0x%02X", it) }.join(", ")}," }.join("\n")
  end
end

GraphemeTables.new(version: ARGV.first || "17.0.0").write
