#!/usr/bin/env ruby
# script/test — run TextMate framework tests
#
# Usage:
#   script/test                  # run every framework's tests
#   script/test plist scope      # run just the listed frameworks

Dir.chdir(File.expand_path('..', __dir__))

targets =
  if ARGV.empty?
    `ninja -t targets`.lines
                      .filter_map { it[%r{^([A-Za-z][\w]*)/test/run:}, 1] }
                      .uniq
                      .sort
                      .map { "#{it}/test/run" }
  else
    ARGV.map { "#{it}/test/run" }
  end

abort 'no test targets found (did you run ./configure?)' if targets.empty?

# Ninja numbers a status line by the edges finished when an edge starts, and
# test edges run in the console pool, which prints nothing on completion. So
# ninja's own last line always ends short of the total, whether or not every
# suite ran. The verdict comes from the exit status, so it is printed here.
system('ninja', '-k', '0', *targets)
status = $?.exitstatus

if status.zero?
  puts "All #{targets.size} test suites passed."
else
  puts "Test suites failed, see above. ninja exited #{status}."
end
exit status
