#!/usr/bin/env ruby
# script/release — publish a build: notarize, archive, sign for Sparkle, release on GitHub, feed
#
# Usage:
#   script/release alpha     # 2.1.0-alpha.N, the alpha channel: the development team
#   script/release beta      # 2.1.0-beta.N, the beta channel: anyone living on the edge
#   script/release           # 2.1.0, the release channel: everyone
#
# The version comes from the newest heading in Changes.md. A prerelease gets a suffix whose number is
# one more than the tags that already carry that channel, so nothing is edited by hand between
# alphas. The build number is the commit count, which the build derives itself.
#
# What happens, in order: a prerelease.rave carrying the suffix is written for this one build,
# script/notarize builds, signs, submits and staples, the stapled application is zipped, the zip is
# signed with the production Sparkle key from the login keychain, a GitHub Release is created for
# the tag with the zip attached, and the entry is added to the appcast in the catalog repository
# next to this one and pushed, which is what the running application checks.
#
# Needs: a clean tree, the Developer ID identity in local.rave, the notarytool keychain profile,
# the Sparkle production key under the textmate3-production account, gh logged in, and the catalog
# repository checked out beside this one with push access.

require "fileutils"
require "shellwords"
require "rexml/document"
require "time"

ROOT          = File.expand_path("..", __dir__)
CATALOG       = File.expand_path("../api.textmate3.com", ROOT)
APPCAST       = File.join(CATALOG, "docs/appcast.xml")
BUILD_DIR     = File.expand_path("~/build/textmate/release")
APP           = File.join(BUILD_DIR, "Applications/TextMate/TextMate.app")
RELEASES_DIR  = File.join(BUILD_DIR, "_Release")
SIGN_UPDATE   = File.join(ROOT, "vendor/Sparkle/bin/sign_update")
SPARKLE_KEY   = "textmate3-production"
REPOSITORY    = "textmate3/textmate"
MINIMUM_MACOS = "26.0"

Dir.chdir(ROOT)

channel = ARGV.first || "release"
abort "usage: script/release [alpha|beta]" unless %w[alpha beta release].include?(channel)

def run(*command)
  puts "→ #{command.map(&:to_s).shelljoin}"
  system(*command) or abort "script/release: #{command.first} failed"
end

def capture(*command)
  output = IO.popen(command, &:read)
  abort "script/release: #{command.first} failed" unless $?.success?
  output.strip
end

# Preconditions, each named so the failure says what to fix.
abort "script/release: the tree has uncommitted changes" unless capture("git", "status", "--porcelain").empty?
abort "script/release: no Developer ID identity in local.rave" unless File.exist?("local.rave") && File.read("local.rave") =~ /^set CS_IDENTITY\s+"Developer ID/
abort "script/release: the catalog repository is not beside this one at #{CATALOG}" unless File.exist?(APPCAST)
run "gh", "auth", "status"

# The version: the notes' newest heading, plus the prerelease suffix.
base_version = File.read("Applications/TextMate/about/Changes.md")[/^## .* \(v(.+?)\)$/, 1]
abort "script/release: no version heading in Changes.md" unless base_version

existing_tags = capture("git", "tag", "--list", "v#{base_version}-#{channel}.*").lines.map(&:strip)
version =
  if channel == "release"
    base_version
  else
    numbers = existing_tags.map { |tag| tag[/\.(\d+)\z/, 1].to_i }
    "#{base_version}-#{channel}.#{numbers.max.to_i + 1}"
  end
tag = "v#{version}"
abort "script/release: #{tag} already exists" unless capture("git", "tag", "--list", tag).empty?

puts "Releasing #{version} on the #{channel} channel"

# The build, with the suffix in place for it and gone after.
suffix = channel == "release" ? "" : version.sub(base_version, "")
File.write("prerelease.rave", "set APP_PRERELEASE \"#{suffix}\"\n")
begin
  run "script/notarize"
ensure
  FileUtils.rm_f("prerelease.rave")
end

built_version = capture("plutil", "-extract", "CFBundleShortVersionString", "raw", "-o", "-", File.join(APP, "Contents/Info.plist"))
build_number  = capture("plutil", "-extract", "CFBundleVersion", "raw", "-o", "-", File.join(APP, "Contents/Info.plist"))
abort "script/release: the built application says #{built_version}, not #{version}" unless built_version == version

# The archive, and its Sparkle signature.
FileUtils.mkdir_p(RELEASES_DIR)
zip = File.join(RELEASES_DIR, "TextMate-#{version}.zip")
FileUtils.rm_f(zip)
run "/usr/bin/ditto", "-c", "-k", "--keepParent", APP, zip
signature_attributes = capture(SIGN_UPDATE, "--account", SPARKLE_KEY, zip)
signature = signature_attributes[/sparkle:edSignature="([^"]+)"/, 1]
length    = signature_attributes[/length="(\d+)"/, 1]
abort "script/release: sign_update gave no signature" unless signature && length

# The notes: what landed since the previous tag on this channel, or since the last tag of any kind.
previous = existing_tags.max_by { |tag| tag[/\.(\d+)\z/, 1].to_i } || capture("git", "describe", "--tags", "--abbrev=0", "--always", "HEAD~1")
notes = capture("git", "log", "--format=- %s", "#{previous}..HEAD")
notes = "- The first #{channel} of #{base_version}." if notes.empty?
notes_file = File.join(RELEASES_DIR, "TextMate-#{version}.md")
File.write(notes_file, notes + "\n")

# The GitHub Release: the tag, the notes, the zip.
release_arguments = ["gh", "release", "create", tag, zip, "--repo", REPOSITORY, "--title", "TextMate #{version}", "--notes-file", notes_file, "--target", capture("git", "rev-parse", "HEAD")]
release_arguments << "--prerelease" unless channel == "release"
run(*release_arguments)
download_url = "https://github.com/#{REPOSITORY}/releases/download/#{tag}/#{File.basename(zip)}"

# The appcast entry, newest first, in the channel's name for a prerelease.
document = REXML::Document.new(File.read(APPCAST))
feed     = document.elements["rss/channel"] or abort "script/release: #{APPCAST} has no channel"

item = REXML::Element.new("item")
item.add_element("title").text = "TextMate #{version}"
item.add_element("sparkle:version").text = build_number
item.add_element("sparkle:shortVersionString").text = version
item.add_element("sparkle:channel").text = channel unless channel == "release"
item.add_element("sparkle:minimumSystemVersion").text = MINIMUM_MACOS
item.add_element("pubDate").text = Time.now.utc.rfc2822
item.add_element("link").text = "https://github.com/#{REPOSITORY}/releases/tag/#{tag}"
description = item.add_element("description")
description.add(REXML::CData.new("<ul>\n" + notes.lines.map { |line| "<li>#{line.sub(/^- /, "").strip}</li>" }.join("\n") + "\n</ul>"))
enclosure = item.add_element("enclosure")
enclosure.add_attributes("url" => download_url, "length" => length, "type" => "application/octet-stream", "sparkle:edSignature" => signature)

first_item = feed.elements["item"]
if first_item
  feed.insert_before(first_item, item)
else
  feed.add_element(item)
end

formatter = REXML::Formatters::Pretty.new(1)
formatter.compact = true
output = +""
formatter.write(document, output)
File.write(APPCAST, output.gsub(/^ +/) { |spaces| "\t" * spaces.length } + "\n")

Dir.chdir(CATALOG) do
  run "git", "add", "docs/appcast.xml"
  run "git", "commit", "-m", "Publish TextMate #{version} to the #{channel} channel"
  run "git", "push"
end

puts
puts "Released #{version}"
puts "  archive  #{download_url}"
puts "  feed     https://api.textmate3.com/appcast.xml"
puts "  notes    #{notes_file}"
