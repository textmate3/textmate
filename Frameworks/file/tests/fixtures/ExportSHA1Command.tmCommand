	<key>input</key>
	<string>document</string>
	<key>name</key>
	<string>Hash Document</string>
	<key>output</key>
	<string>replaceDocument</string>
	<key>scope</key>
	<string>attr.rev-path.sha1</string>
	<key>uuid</key>
