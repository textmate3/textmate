<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>TrueWithBadLocationAndVariable</string>
	<key>requiredCommands</key>
	<array>
		<dict>
			<key>command</key>
			<string>true</string>
			<key>locations</key>
			<array>
				<string>/foo/bar/true</string>
			</array>
			<key>variable</key>
			<string>TM_TRUE</string>
		</dict>
	</array>
</dict>
</plist>
