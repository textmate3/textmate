target "${dirname}" {
	require BundlesManager GrammarSchema OakAppKit OakFoundation OakTextView TMFileReference bundles cf command document io ns parse plist regexp scope settings text theme
	headers src/BundleEditor.h

	files resources/* templates/*.plist gfx/**/*.png "Resources"

	sources src/*.{cc,mm,swift}
	frameworks Cocoa UniformTypeIdentifiers
}
