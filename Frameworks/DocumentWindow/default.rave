target "${dirname}" {
	require BundleEditor BundlesManager FileBrowser Find HTMLOutputWindow MenuBuilder OakAppKit OakTabBarView OakCommand OakFilterList OakFoundation OakSystem OakTextView Preferences bundles crash document file io ns regexp scm settings text
	headers src/{DocumentWindowController,OakProjectStateStore}.h
	# The SDK's sqlite by path, so a Homebrew sqlite on the linker's search path is never
	# picked up. Nothing the application ships may load a library from outside the system.
	capture SDK_PATH "xcrun --sdk macosx --show-sdk-path"
	libraries "${SDK_PATH}/usr/lib/libsqlite3.tbd"

	sources src/*.mm
	frameworks Cocoa
}
