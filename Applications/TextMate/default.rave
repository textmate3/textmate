target "${dirname}" {
	require BundleEditor BundleMenu BundlesManager CommitWindow CrashReporter DocumentWindow Find HTMLOutputWindow MenuBuilder OakAppKit OakCommand OakFilterList OakFoundation OakSystem OakTextView Preferences SoftwareUpdate authorization bundles cf command crash document io network ns plist regexp scm settings text theme

	set HTML_HEADER     "${dir}/templates/header.html"
	set HTML_FOOTER     "${dir}/templates/footer.html"

	set     TEXTMATE_CHANGES "${dir}/about/Changes.md"
	capture TEXTMATE_VERSION "grep -om1 '^## .* (v.*)$' '${TEXTMATE_CHANGES}'|sed 's/.*(v\\(.*\))/\\1/'"

	config "debug" {
		add PLIST_FLAGS "-d'CS_GET_TASK_ALLOW=true'"
	}

	config "release" {
		add PLIST_FLAGS "-d'CS_GET_TASK_ALLOW=false'"
	}

	expand CS_ENTITLEMENTS "${dir}/Entitlements.plist"

	add PLIST_FLAGS "-dAPP_VERSION='${TEXTMATE_VERSION}'"
	add MD_FLAGS    "-h'${HTML_HEADER}' -f'${HTML_FOOTER}'"
	add CS_FLAGS    "--entitlements '${CS_ENTITLEMENTS}'"

	# Sparkle is a vendored prebuilt framework: compiled against, embedded into the application, and
	# found at run time through the rpath. It arrives ad hoc signed and is re-signed with the
	# application's identity once copied, its XPC services, updater and helper first, in the order
	# Sparkle's own instructions give, so that library validation admits it.
	add FLAGS    "-Fvendor/Sparkle"
	add LN_FLAGS "-Fvendor/Sparkle -framework Sparkle -Wl,-rpath,@executable_path/../Frameworks"
	set CS_NESTED "Frameworks/Sparkle.framework/Versions/B/XPCServices/Installer.xpc/Contents/MacOS/Installer Frameworks/Sparkle.framework/Versions/B/XPCServices/Downloader.xpc/Contents/MacOS/Downloader Frameworks/Sparkle.framework/Versions/B/Autoupdate Frameworks/Sparkle.framework/Versions/B/Updater.app/Contents/MacOS/Updater Frameworks/Sparkle.framework/Versions/B/Sparkle"

	prefix "${target}.app/Contents"

	copy  ../../vendor/Sparkle/Sparkle.framework "Frameworks"
	files resources/* icons/*.icns @PrivilegedTool "Resources"
	files @mate @tm_query @gtm "MacOS"
	files about/*            "Resources/About"
	files Info.plist         "."
	copy  support/*          "SharedSupport"
	copy  @Dialog2           "PlugIns"

	sources src/*.{cc,mm,swift}
	executable "MacOS/${target}"
	frameworks Cocoa
}
