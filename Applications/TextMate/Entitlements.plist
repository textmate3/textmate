<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Library validation admits only code signed by Apple or by the same Team ID as
	     the application. Two things need it off. An ad hoc signed build has no Team ID,
	     so it can never match the embedded Sparkle framework, whatever Sparkle is signed
	     with, and dyld refuses to start the application. And third party plug-ins in
	     the Application Support PlugIns folder are signed by whoever wrote them, or not
	     at all, and load only with validation off. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.get-task-allow</key>
	<${CS_GET_TASK_ALLOW}/>
</dict>
</plist>
