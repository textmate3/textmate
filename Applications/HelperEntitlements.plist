<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared by the CLI helpers shipped inside TextMate.app: mate, tm_query and
	     PrivilegedTool. The only entitlement they actually need is
	     library-validation-disable so Hardened Runtime accepts the Homebrew-signed
	     libcapnp / libkj dylibs (different Team ID than the adhoc-signed helpers).
	     Unlike Applications/TextMate/Entitlements.plist this file contains no
	     ${…} template placeholders, so no `expand` step is required — codesign
	     can read it directly. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
