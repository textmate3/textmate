target "${dirname}" {
	require authorization io text
	sources src/*.cc
	executable "${target}"

	# Inherit the app's entitlements so hardened runtime + library validation
	# don't reject the Homebrew-signed libcapnp/libkj dylibs we link against.
	add CS_FLAGS "--entitlements '${dir}/../TextMate/Entitlements.plist'"
}
