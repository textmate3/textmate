#!/bin/sh
# set -u
function error () { printf >&2 "%s\n\nPlease see README.md for build instructions.\n" "$1"; exit 1; }

# ===============================
# = Check required dependencies =
# ===============================

for dep in ninja multimarkdown pgrep pkill; do
  which -s "$dep" || error "*** dependency missing: ‘${dep}’."
done

# The toolchain the build needs, named in three files at the top of the tree.
#
# .macos-version is the deployment target, which the rave files read, and which
# needs an SDK at least that new. .swift-version is the Swift that ships with the
# Xcode carrying that SDK. An older Xcode fails later, deep in the build, with an
# error about a missing SDK that never names either, so both are checked here by
# name. .ruby-version is the Ruby that bin/rave and the scripts run on. rv reads
# it and provides that Ruby, but bin/rave runs on whatever ruby the PATH finds,
# so that one is checked too. Versions compare as numbers, major then minor, so
# 6.10 is newer than 6.4 and a 4.0.7 passes a 4.0.9 pin.
at_least () {
  awk -v have="$1" -v need="$2" 'BEGIN { split(have, h, "."); split(need, n, "."); exit !((h[1] + 0 > n[1] + 0) || (h[1] + 0 == n[1] + 0 && h[2] + 0 >= n[2] + 0)) }'
}

macos_needed=$(tr -d '[:space:]' < .macos-version)
macos_sdk=$(xcrun --sdk macosx --show-sdk-version 2>/dev/null)
test -n "$macos_sdk" || error "*** no macOS SDK: ‘xcrun --sdk macosx --show-sdk-version’ answered nothing. Install Xcode and select it with xcode-select."
at_least "$macos_sdk" "$macos_needed" \
  || error "*** the macOS SDK is ${macos_sdk}, and this build targets macOS ${macos_needed}, see .macos-version. The Xcode for macOS ${macos_needed} carries the SDK it needs."

swift_needed=$(tr -d '[:space:]' < .swift-version)
swift_have=$(xcrun --sdk macosx swiftc --version 2>/dev/null | sed -n 's/.*Apple Swift version \([0-9][0-9.]*\).*/\1/p' | head -1)
test -n "$swift_have" || error "*** no Swift compiler: ‘xcrun --sdk macosx swiftc --version’ answered nothing. Install Xcode and select it with xcode-select."
at_least "$swift_have" "$swift_needed" \
  || error "*** Swift ${swift_have} is older than the ${swift_needed} this build needs, see .swift-version. The Xcode for macOS ${macos_needed} provides it."

ruby_needed=$(tr -d '[:space:]' < .ruby-version)
ruby_have=$(ruby -e 'print RUBY_VERSION' 2>/dev/null)
test -n "$ruby_have" || error "*** no Ruby: ‘ruby’ is not on the PATH. bin/rave and the scripts run on the Ruby in .ruby-version, which rv provides, see the Brewfile."
at_least "$ruby_have" "$ruby_needed" \
  || error "*** Ruby ${ruby_have} is older than the ${ruby_needed} this build needs, see .ruby-version. rv provides it: ‘rv run sh ./configure’ for this once, or ‘rv shell zsh’ to put it on the PATH for good."

if [[ -e local.rave ]]; then
  echo >&2 "Skipping writing ‘local.rave’: File already exists"
else
  echo >> local.rave 'add FLAGS    "-I/usr/local/include"'

  for hdr in boost/crc.hpp; do
    test -f "/usr/local/include/${hdr}" || error "*** dependency missing: ‘/usr/local/include/${hdr}’. Install dependency and/or update ‘local.rave’ with correct path."
  done
fi

# ========================
# = Generate build files =
# ========================

if [[ -d "$builddir" ]];
  then bin/rave -crelease -tTextMate -b"$builddir"
  else bin/rave -crelease -tTextMate
fi
