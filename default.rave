set APP_MIN_OS    "26.0"

# The signing identity. Ad hoc here, so anyone can build. The Developer ID identity, which is what a
# release and a notarized build need, is set in local.rave on the machine that holds the certificate:
#
#     set CS_IDENTITY "Developer ID Application: Name (TEAMID)"
#
# Everything embedded in the application, the command line tools, the privileged tool, the dialog
# plug-in and the vendored Sparkle framework with what it embeds, is signed with the same identity.
set CS_IDENTITY   "-"

set C_FLAGS       "-std=c99"
set CXX_FLAGS     "-std=c++23"
set OBJC_FLAGS    "${C_FLAGS} -fobjc-arc"
set OBJCXX_FLAGS  "${OBJC_FLAGS} ${CXX_FLAGS}"
set SWIFT_FLAGS   "-swift-version 6 -target arm64-apple-macosx${APP_MIN_OS}"

add FLAGS         "-funsigned-char"
add FLAGS         "-Wall -Wwrite-strings -Wformat -Winit-self -Wmissing-include-dirs"
add FLAGS         "-Wno-parentheses -Wno-sign-compare -Wno-switch -Wno-c99-designator"
add FLAGS         "-D'NULL_STR=\"\\uFFFF\"' -D'REST_API=\"https://api.textmate3.com\"'"

# The Ed25519 public key that the bundle catalog index and tarballs must be signed with, base64 of
# the raw 32 byte key, the same format Sparkle uses for SUPublicEDKey. Local development overrides
# this in local.rave with a development key, the same way it overrides REST_API. The production
# private half lives in the maintainer's login keychain as "TextMate bundle signing (production)".
add FLAGS         "-D'BUNDLE_PUBLIC_ED_KEY=\"/H4k7uGYRnMzP59K/A2lyy6Cduxz++AkUCMRpAo03As=\"'"
add FLAGS         "-IShared/include"
add FLAGS         "-mmacosx-version-min=${APP_MIN_OS}"

set LN_FLAGS      "-mmacosx-version-min=${APP_MIN_OS} -fobjc-link-runtime"

set IB_FLAGS      "--errors --warnings --notices --output-format human-readable-text"

set AC_FLAGS      "--errors --warnings --notices --output-format human-readable-text"
add AC_FLAGS      "--minimum-deployment-target=${APP_MIN_OS} --platform=macosx"

set CS_FLAGS      "--force --options runtime"

# For code copied into the application from outside the build, re-signed innermost first before the
# application is. Entitlements are preserved, since Sparkle's XPC services carry their own.
set CS_NESTED_FLAGS "--force --options runtime --preserve-metadata=entitlements"

# Sparkle: where the application looks for its update feed, and the Ed25519 public key updates must
# be signed with. Local development overrides both in local.rave, pointing the feed at the stand-in
# server on localhost and the key at a development keypair. The production private half lives in the
# maintainer's login keychain under the Sparkle item's textmate3-production account.
set SU_FEED_URL      "https://api.textmate3.com/appcast.xml"
set SU_PUBLIC_ED_KEY "Ql63khOrqqpJie/GjnPx/YxCLWFTaHBKULBpi5Gyuxo="

set PLIST_FLAGS   "-dTARGET_NAME='${target}' -dAPP_MIN_OS='${APP_MIN_OS}' -dSU_FEED_URL='${SU_FEED_URL}' -dSU_PUBLIC_ED_KEY='${SU_PUBLIC_ED_KEY}'"

prelude Shared/PCH/prelude.*
libraries c++

config debug {
	require OakDebug

	add FLAGS    "-Os"
	add FLAGS    "-fsanitize=address -fno-omit-frame-pointer"
	add SWIFT_FLAGS "-Onone -g"
	add LN_FLAGS "-fsanitize=address"
	add CS_FLAGS "--timestamp=none"
	add CS_NESTED_FLAGS "--timestamp=none"
}

config release {
	add FLAGS    "-Os -DNDEBUG -flto=thin"
	add SWIFT_FLAGS "-O"
	add LN_FLAGS "-flto=thin -Wl,-cache_path_lto,'\\${builddir}/.cache'"
	add LN_FLAGS "-Wl,-dead_strip -Wl,-dead_strip_dylibs"
	add CS_FLAGS "--timestamp"
	add CS_NESTED_FLAGS "--timestamp"
}

load local.rave {Applications,Frameworks,PlugIns,vendor}/*/*.rave
